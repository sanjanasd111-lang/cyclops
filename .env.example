# AYUSHSetu AI — Environment Configuration Example
# Smart India Hackathon (SIH) Problem Statement 26044
# Copy this file to .env.local and populate with your credentials.

# Supabase Infrastructure (PostgreSQL, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini AI (Assistive Career Intelligence & Interview Coach)
GEMINI_API_KEY=your-google-gemini-api-key

# Application Core Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENABLE_DEMO_DATA=false

# Optional Analytics & Telemetry
NEXT_PUBLIC_ENVIRONMENT=development
